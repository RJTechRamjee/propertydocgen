### Test 1: Generate a PDF Document on an existing document (SUCCESS Case - Updates existing record)
# Base Path: /DocumentGenerationService (from the @path annotation)
# Action Name: generateDocument
# Note: This is a bound action that updates the existing document, not creates a new one
# @name GeneratePDF
POST http://localhost:4004/DocumentGenerationService/Documents(ID=123e4567-e89b-12d3-a456-426614174000)/DocumentGenerationService.generateDocument
Content-Type: application/json

{
    "docType": "PDF",
    "content": "Content for the PDF.",
    "preview": true
}



### Test 2: Use Unsupported Document Type (ERROR Case)
# @name GenerateError
POST http://localhost:4004/DocumentGenerationService/generateDocument
Content-Type: application/json

{
    "docType": "HTML",
    "content": "This type should trigger the 400 error in the handler."
}

### Test 3: get metadata
GET http://localhost:4004/DocumentGenerationService/$metadata

### Test 4: Download PDF using OData stream (direct access to pdfFile property)
# After generating a PDF, you can download it directly via OData stream
# @name DownloadPDFStream
GET http://localhost:4004/DocumentGenerationService/Documents(ID=123e4567-e89b-12d3-a456-426614174000)/pdfFile

### Test 5: Get all documents
GET http://localhost:4004/DocumentGenerationService/Documents

### Test 6: Create a new document (for testing purposes)
POST http://localhost:4004/DocumentGenerationService/Documents(9c858901-8a57-4791-81fe-4c455b099bc9)/DocumentGenerationService.generateDocument
Content-Type: application/json

{"docType":"PDF","content":"Hello Dear, how are you?","preview":true}